# RUN: llc -mtriple=x86_64-- -stop-after fix-stackmaps-spill-reloads --yk-stackmap-spillreloads-fix %s -o - | FileCheck %s

# SelectionDAG can lower a switch using the source of a zero extension after a
# branch stackmap.

# CHECK-LABEL: name: switch_lookthrough
# CHECK-LABEL: bb.0:
# CHECK: STACKMAP 1, 0, $dl, 3
# CHECK-NEXT: dead $ecx = MOVZX32rr8 $dl, implicit-def dead $rcx
# CHECK-NEXT: $dl = SUB8ri killed $dl, 3, implicit-def dead $eflags

---
name: switch_lookthrough
tracksRegLiveness: true
frameInfo:
  hasStackMap: true
body: |
  bb.0:
    liveins: $rdx
    $ecx = MOVZX32rr8 $dl, implicit-def $rcx
    STACKMAP 1, 0, $ecx, 3
    $dl = SUB8ri $dl, 3, implicit-def $eflags
    RET64 implicit $dl
...

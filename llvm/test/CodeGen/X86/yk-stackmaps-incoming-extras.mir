# RUN: llc -mtriple=x86_64-- --yk-stackmap-add-locs %s -o - | FileCheck %s

# Reproduce the CPython failure: load a 32-bit incoming argument at RBP+16,
# then track only its low byte. The extra location is memory, not RIP.
# CHECK-LABEL: __LLVM_StackMaps:
# CHECK-LABEL: .quad 44
# CHECK: .byte 2
# CHECK-NEXT: .byte 1
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 1
# CHECK-NEXT: .short 12
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long 0
# CHECK-NEXT: .byte 3
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 1
# CHECK-NEXT: .short 6
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long 16
---
name: incoming
tracksRegLiveness: true
frameInfo:
  hasStackMap: true
  stackSize: 32
fixedStack:
  - { id: 0, type: default, offset: 0, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    $rbp = frame-setup MOV64rr $rsp
    $r12d = MOV32rm $rbp, 1, $noreg, 16, $noreg :: (load (s32) from %fixed-stack.0)
    STACKMAP 44, 0, $r12b, 3
    RET64

# An explicitly tracked incoming slot can use its register copy as the primary
# location, retaining the incoming slot as a full Indirect location.
# CHECK-LABEL: .quad 45
# CHECK: .byte 2
# CHECK-NEXT: .byte 1
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 12
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long 0
# CHECK-NEXT: .byte 3
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 6
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long 16
---
name: incoming_indirect
tracksRegLiveness: true
frameInfo:
  hasStackMap: true
  stackSize: 32
fixedStack:
  - { id: 0, type: default, offset: 0, size: 8, alignment: 8, isImmutable: true }
body: |
  bb.0:
    $rbp = frame-setup MOV64rr $rsp
    $r12 = MOV64rm $rbp, 1, $noreg, 16, $noreg :: (load (s64) from %fixed-stack.0)
    STACKMAP 45, 0, 1, 8, $rbp, 16, 3
    RET64 $r12

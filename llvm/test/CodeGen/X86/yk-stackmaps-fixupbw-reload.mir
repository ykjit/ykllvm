# RUN: llc -mtriple=x86_64-- -run-pass=x86-fixup-bw-insts --yk-stackmap-add-locs %s -o - | FileCheck %s --check-prefix=YK
# RUN: llc -mtriple=x86_64-- -run-pass=x86-fixup-bw-insts %s -o - | FileCheck %s --check-prefix=NOYK

# Check that with yk additional locations enabled, 8/16-bit reloads from stack
# slots aren't widened to zero-extending loads.

# YK: $di = MOV16rm $rbp, 1, $noreg, -16, $noreg
# YK: $sil = MOV8rm $rbp, 1, $noreg, -14, $noreg
# NOYK: $edi = MOVZX32rm16 $rbp, 1, $noreg, -16, $noreg
# NOYK: $esi = MOVZX32rm8 $rbp, 1, $noreg, -14, $noreg
---
name: main
tracksRegLiveness: true
frameInfo:
  hasStackMap:     true
  stackSize:       16
stack:
  - { id: 0, type: spill-slot, offset: -16, size: 2, alignment: 2 }
  - { id: 1, type: spill-slot, offset: -14, size: 1, alignment: 1 }
body: |
  bb.0:
    liveins: $edi, $esi, $rbp
    MOV16mr $rbp, 1, $noreg, -16, $noreg, killed $di :: (store (s16) into %stack.0)
    MOV8mr $rbp, 1, $noreg, -14, $noreg, killed $sil :: (store (s8) into %stack.1)
    $di = MOV16rm $rbp, 1, $noreg, -16, $noreg :: (load (s16) from %stack.0)
    $sil = MOV8rm $rbp, 1, $noreg, -14, $noreg :: (load (s8) from %stack.1)
    STACKMAP 1, 0, killed $di, killed $sil, 3
    RET64
...

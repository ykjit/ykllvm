# RUN: llc -mtriple=x86_64-- --yk-stackmap-add-locs %s -o - | FileCheck %s
# Multiple stack copies need to be tracked even when there's no register around.
# CHECK-LABEL: __LLVM_StackMaps:
# CHECK-LABEL: .quad 40
# CHECK: .short 1
# CHECK-NEXT: .byte 2
# CHECK-NEXT: .byte 3
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 6
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long -24
# CHECK-NEXT: .byte 3
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 6
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long -16

# Reloading one copy makes both stack slots visible as register extras.
# CHECK-LABEL: .quad 41
# CHECK: .short 1
# CHECK-NEXT: .byte 1
# CHECK-NEXT: .byte 1
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 12
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 2
# CHECK-NEXT: .short -24
# CHECK-NEXT: .short -16
# CHECK-NEXT: .long 0
---
name: stack_only_alias
tracksRegLiveness: true
frameInfo:
  hasStackMap: true
stack:
  - { id: 0, type: spill-slot, offset: -16, size: 8, alignment: 8 }
  - { id: 1, type: spill-slot, offset: -24, size: 8, alignment: 8 }
body: |
  bb.0:
    $rbp = frame-setup MOV64rr $rsp
    $rsp = SUB64ri8 $rsp, 32, implicit-def dead $eflags
    $r12 = MOV64rm $rbp, 1, $noreg, -16, $noreg :: (load (s64) from %stack.0)
    MOV64mr $rbp, 1, $noreg, -24, $noreg, $r12 :: (store (s64) into %stack.1)
    $r12 = MOV64ri 0
    STACKMAP 40, 0, 1, 8, $rbp, -16, 3
    $r12 = MOV64rm $rbp, 1, $noreg, -24, $noreg :: (load (s64) from %stack.1)
    STACKMAP 41, 0, $r12, 3
    $rsp = ADD64ri8 $rsp, 32, implicit-def dead $eflags
    RET64 $r12

# Stack-only aliases of incoming arguments use tagged non-negative offsets in
# the spill map. Emit the actual frame offset, not the internal tag.
# CHECK-LABEL: .quad 42
# CHECK: .short 1
# CHECK-NEXT: .byte 2
# CHECK-NEXT: .byte 3
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 6
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long 16
# CHECK-NEXT: .byte 3
# CHECK-NEXT: .byte 0
# CHECK-NEXT: .short 8
# CHECK-NEXT: .short 6
# CHECK-NEXT: .short 0
# CHECK-NEXT: .short 0
# CHECK-NEXT: .long -16
---
name: stack_only_incoming_alias
tracksRegLiveness: true
frameInfo:
  hasStackMap: true
fixedStack:
  - { id: 0, type: default, offset: 0, size: 8, alignment: 8, isImmutable: true }
stack:
  - { id: 0, type: spill-slot, offset: -16, size: 8, alignment: 8 }
body: |
  bb.0:
    $rbp = frame-setup MOV64rr $rsp
    $rsp = SUB64ri8 $rsp, 32, implicit-def dead $eflags
    $r12 = MOV64rm $rbp, 1, $noreg, 16, $noreg :: (load (s64) from %fixed-stack.0)
    MOV64mr $rbp, 1, $noreg, -16, $noreg, $r12 :: (store (s64) into %stack.0)
    $r12 = MOV64ri 0
    STACKMAP 42, 0, 1, 8, $rbp, -16, 3
    $rsp = ADD64ri8 $rsp, 32, implicit-def dead $eflags
    RET64
